  }
  const hashResumo=pgHash_({versao:PG.VERSAO,dias:m.dias});
  if(forcarFotos||p.getProperty('PG_RESUMO')!==hashResumo){pgEscreverResumo_(ss,m,photoCache,fotoAvisos);p.setProperty('PG_RESUMO',hashResumo);}
