function c43PaginarTexto_(text,width,lines){const all=[];String(text||'').replace(/\*\*/g,'').split(/\n/).forEach(p=>{let line='';p.split(/\s+/).filter(Boolean).forEach(word=>{while(word.length>width){if(line){all.push(line);line='';}all.push(word.slice(0,width));word=word.slice(width);}if(line.length+word.length+1>width){all.push(line);line='';}line+=(line?' ':'')+word;});all.push(line);});const pages=[];for(let i=0;i<all.length;i+=lines){const t=all.slice(i,i+lines).join('\n').trim();if(t)pages.push(t);}return pages;}


