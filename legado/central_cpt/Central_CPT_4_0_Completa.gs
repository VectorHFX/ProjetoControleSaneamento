function c40Binario_(id,blob,nome,pasta){blob.setName(nome);if(!id)return pasta.createFile(blob).getId();const r=UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files/'+encodeURIComponent(id)+'?uploadType=media&supportsAllDrives=true',{method:'patch',contentType:blob.getContentType(),payload:blob.getBytes(),headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});if(r.getResponseCode()>=300)throw Error('Não foi possível atualizar o arquivo existente ('+r.getResponseCode()+'). Confira sua permissão de edição.');DriveApp.getFileById(id).setName(nome);return id;}
