}
function pg3mColParceiros_(s,m,criar){
 const nomes=['janeiro','fevereiro','marco','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'],found=[],months=[];
 const last=s.getLastColumn();if(last<3)throw Error('Cabeçalhos mensais ausentes.');
 s.getRange(2,3,1,last-2).getDisplayValues()[0].forEach((v,i)=>{const n=pg3mNorm_(v),k=pg3mMesCab_(v)||(nomes.includes(n)?'2026-'+String(nomes.indexOf(n)+1).padStart(2,'0'):'');if(k)months.push(i+3);if(k===m)found.push(i+3);});
 if(found.length>1)throw Error('Competência duplicada na máscara.');if(found.length)return found[0];if(!criar)return 0;
 if(!months.length)throw Error('Nenhum bloco mensal reconhecido para criar a competência.');
 const start=months[months.length-1],merged=s.getRange(2,start).getMergedRanges(),width=merged.length?merged[0].getNumColumns():1;
 const end=Math.max(last,start+width-1),col=end+1;pg3mGrow_(s,92,col+width-1);
