}
function pg3ExportarMensal(p){
 pg3Mes_(p.mes);if(!PG3_CAMPOS[p.tipo])throw Error('Ferramenta inválida.');
 const lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('Outra entrega está sendo preparada. Aguarde.');
 try{
  const target=pg32Destino_(p);let linhas=[],revisao=0;
  if(p.tipo==='parceiros'){
   const e=pg3Get_('mensal:'+p.tipo+':'+p.mes);if(e.rev!==p.rev)throw Error('O rascunho mudou. Atualize a consulta antes de publicar.');
   if(!p.destinoToken||p.destinoToken!==target.token)throw Error('A máscara foi alterada desde a consulta. Reabra a entrega para conferir os valores atuais. Seu rascunho está salvo.');
   const campos=e.valor.campos||{};if(!Object.keys(campos).some(k=>campos[k].confirmado))throw Error('Salve ao menos um campo conferido.');
   // Só cria a competência quando há um rascunho válido para publicar.
   const col=target.col||pg3mColParceiros_(target.s,p.mes,true);
   linhas=pg32GravarConferidos_(target.s,col,campos,p.tipo);revisao=e.rev;
  }
  // A partir daqui a publicação, quando solicitada, já foi concluída.
  const response={planilha:target.id,oficial:true,linhas,revisao,quando:new Date().toISOString(),avisos:[]};
  try{response.destinoToken=pg32Destino_(p).token;}catch(e){response.destinoToken='';response.avisos.push('Reabra a entrega antes da próxima publicação.');}
  try{
   const dest=pg3Get_('export:'+p.tipo+':'+p.mes),v=Object.assign({},dest.valor,response),pasta=pg3Pasta_();
   if(dest.valor.planilha&&dest.valor.planilha!==target.id)v.copiaAnterior=dest.valor.planilha;
   // Links de arquivos antigos não aparecem como se fossem a nova entrega.
   const oldXlsx=dest.valor.xlsx,oldPdf=dest.valor.pdf;delete v.xlsx;delete v.pdf;
   for(const format of ['xlsx','pdf'])try{const id=pg3Binario_(format==='xlsx'?oldXlsx:oldPdf,pg3SheetBlob_(target.id,format),p.tipo+' '+p.mes+'.'+format,pasta);v[format]=id;response[format]=id;}catch(e){response.avisos.push(format.toUpperCase()+': '+e.message);}
   v.avisos=response.avisos;pg3PutUnlocked_(dest.key,dest.rev,v);
  }catch(e){response.avisos.push('O registro dos arquivos não foi concluído: '+e.message);}
