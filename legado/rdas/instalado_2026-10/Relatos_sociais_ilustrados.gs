function abrirRelatosSociais(){const html=HtmlService.createHtmlOutput(CPT_AS_HTML).setWidth(1240).setHeight(740);SpreadsheetApp.getUi().showModalDialog(html,'CPT | Relatos ilustrados das ações sociais');}

const CPT_AS_HTML = "<!doctype html><html lang=\"pt-BR\"><head><base target=\"_blank\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n*{box-sizing:border-box}body{margin:0;background:#edf4f8;color:#172f43;font:15px Arial}header{background:#073b56;color:white;padding:20px 28px;border-bottom:4px solid #009fe3}h1{font-size:25px;margin:0 0 7px}h2{font-size:20px}p{line-height:1.5}.bar{padding:16px 24px;display:flex;gap:12px;align-items:end;flex-wrap:wrap}.bar label{flex:1;min-width:190px}label{display:block;font-weight:bold;font-size:14px}input,select,textarea{font:15px Arial;width:100%;margin-top:7px;padding:11px;border:1px solid #bed0dc;border-radius:6px;color:#172f43;background:white}textarea{min-height:120px;line-height:1.5;resize:vertical}button,.button{font:15px Arial;cursor:pointer;background:#007d9d;color:white;border:0;border-radius:7px;padding:12px 16px;text-decoration:none;display:inline-block}button:disabled{opacity:.5;cursor:wait}button.secondary{background:white;color:#073b56;border:1px solid #bdd2df}.layout{display:grid;grid-template-columns:minmax(320px,1fr) minmax(400px,1.15fr);gap:24px;padding:0 24px 24px}.editor,.sheet{background:white;border:1px solid #d7e3eb;border-radius:10px;padding:24px}.fields{display:grid;gap:16px}.muted{color:#526c7b;font-size:13px}.notice{background:#fff3de;padding:12px;border-radius:7px}.preview-title{font-size:26px;font-weight:bold;color:#073b56}.metadata{border-collapse:collapse;width:100%;margin:18px 0}td{border:1px solid #d9e3ea;padding:9px;font-size:14px}td:first-child{font-weight:bold;background:#eaf4f8;width:125px}.prose{white-space:pre-wrap;line-height:1.6}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px}.gallery figure{margin:0;padding:8px;background:#f3f7fa}.gallery img{width:100%;height:150px;object-fit:contain}.gallery input{width:auto}figcaption{font-size:13px;line-height:1.5}a{color:#006b94}#status{padding:0 24px 15px;white-space:pre-wrap}#result a{margin:8px 10px 4px 0}details{margin-top:16px}summary{cursor:pointer;font-weight:bold}#history p{border-bottom:1px solid #dce6ed;padding-bottom:12px}:focus-visible{outline:3px solid #008bc3;outline-offset:3px}@media(max-width:920px){.layout{grid-template-columns:1fr}}@media print{header,.bar,#status,.editor{display:none}.layout{display:block;padding:0}.sheet{border:0;padding:0}}\n</style></head><body><header><h1>Relatos ilustrados das ações sociais</h1><div>Texto, fotos e memória das atividades em um documento editável</div></header><div class=\"bar\"><label>Mês da atividade<input id=\"month\" type=\"month\"></label><label>Atividade<select id=\"record\"></select></label><button id=\"reload\" class=\"secondary\">Atualizar lista</button></div><div id=\"status\" role=\"status\" aria-live=\"polite\"></div><main class=\"layout\"><section class=\"editor\"><h2>Conteúdo da entrega</h2><p class=\"muted\">A revisão vale para este documento. As respostas originais e o RDAS são preservados.</p><div id=\"fields\" class=\"fields\"></div><p id=\"source\" class=\"muted\"></p><button id=\"generate\">Gerar documento e PDF</button><div id=\"result\"></div><details><summary>Documentos anteriores</summary><div id=\"history\"></div></details></section><article class=\"sheet\"><div class=\"muted\">CONSÓRCIO PERFORMANCE TAMANDUATEÍ</div><h2 class=\"preview-title\">Relato da atividade</h2><div id=\"preview\"></div><h2>Registro fotográfico</h2><p class=\"muted\">As fotos marcadas compõem a entrega. A lista de presença pode ser anexada depois de digitalizada.</p><div id=\"photos\" class=\"gallery\"></div></article></main><script>\nconst $=id=>document.getElementById(id);let rows=[],current=null,dirty=false,run=0,busy=false;\nconst fields=[['titulo','Tema ou complemento'],['local','Local'],['endereco','Endereço'],['mediacao','Mediação'],['publico','Público'],['participantes','Participantes informados'],['objetivo','Objetivo'],['relato','Relato da atividade'],['resultados','Resultados e encaminhamentos']];\nfunction el(t,text){const e=document.createElement(t);if(text!==undefined)e.textContent=text;return e;}\nfunction link(text,url){const a=el('a',text);a.href=url;a.target='_blank';a.rel='noopener';return a;}\nfunction rpc(name,...args){return new Promise((ok,fail)=>google.script.run.withSuccessHandler(ok).withFailureHandler(fail)[name](...args));}\nfunction msg(s){$('status').textContent=s;}\nfunction paint(){const v=$('preview');v.replaceChildren();if(!current)return;v.append(el('h3',$('f_titulo').value||current.atividade));const t=el('table');t.className='metadata';[['Atividade',current.atividade],['Local',$('f_local').value],['Endereço e bairro',[$('f_endereco').value,current.bairro].filter(Boolean).join(' · ')],['Data e horário',[current.dia.split('-').reverse().join('/'),current.horario].filter(Boolean).join(' · ')],['Mediação',$('f_mediacao').value||'Não informada'],['Equipe registrada',current.equipe],['Público',[$('f_publico').value,$('f_participantes').value!==''?$('f_participantes').value+' participantes informados':''].filter(Boolean).join(' · ')]].forEach(x=>{const tr=el('tr');x.forEach(s=>tr.append(el('td',s||'Não informado')));t.append(tr);});v.append(t);[['Objetivo',$('f_objetivo').value],['Relato da atividade',$('f_relato').value],['Resultados e encaminhamentos',$('f_resultados').value],['Interrupção informada',current.interrupcao]].forEach(x=>{if(x[1]){const p=el('p',x[1]);p.className='prose';v.append(el('h3',x[0]),p);}});}\nasync function choose(){if(dirty&&!confirm('Há alterações ainda não geradas. Trocar de registro e descartar esta edição?')){$('record').value=current.id;return;}current=rows.find(x=>x.id===$('record').value);dirty=false;const token=++run;$('fields').replaceChildren();$('photos').replaceChildren();$('history').replaceChildren();$('result').replaceChildren();$('source').replaceChildren();$('generate').disabled=!current;if(!current){$('preview').replaceChildren(el('p','Nenhum relato elegível neste mês.'));return;}\nfields.forEach(([key,label])=>{const l=el('label',label),i=el(['objetivo','relato','resultados'].includes(key)?'textarea':'input');i.id='f_'+key;i.value=current[key]||'';if(key==='participantes'){i.type='number';i.min='0';i.step='1';}i.oninput=()=>{dirty=true;paint();};l.append(i);$('fields').append(l);});$('source').append(link('Registro original · '+current.id,current.fonte));paint();\ncurrent.documentos.forEach(x=>{const p=el('p','Versão '+x.versao+' · '+x.situacao+' ');if(x.doc)p.append(link('Documento',x.doc));if(x.pdf)p.append(el('span',' · '),link('PDF',x.pdf));if(x.detalhes)p.append(el('br'),el('small',x.detalhes));$('history').append(p);});\nconst id=current.id;for(let n=0;n<current.fotos.length;n++){if(run!==token)return;const u=current.fotos[n],f=el('figure'),label=el('label'),check=el('input');check.type='checkbox';check.checked=true;check.dataset.url=u;check.onchange=()=>dirty=true;label.append(check,el('span',' Incluir imagem '+(n+1)));f.append(label);const holder=el('div','Imagem em consulta…');f.append(holder,link('Original no Drive',u));$('photos').append(f);try{const src=await rpc('carregarFotoRelatoSocial',id,u);if(run!==token)return;const img=el('img');img.src=src;img.alt='Evidência '+(n+1)+' da atividade';holder.replaceChildren(img);}catch(e){holder.textContent='Prévia indisponível. Confira o original ou desmarque esta imagem.';}}\n}\nasync function load(){if(busy)return;if(dirty&&!confirm('Atualizar a lista e descartar o texto ainda não gerado?'))return;dirty=false;busy=true;$('reload').disabled=true;msg('Consultando registros…');try{const d=await rpc('listarRelatosSociais',$('month').value);rows=d.itens;$('record').replaceChildren();rows.forEach(r=>{const o=el('option',r.dia.split('-').reverse().join('/')+' · '+r.atividade+' · '+(r.titulo||r.bairro)+' · '+r.id);o.value=r.id;$('record').append(o);});if(rows.length)$('record').value=rows[0].id;await choose();msg(rows.length+' registros elegíveis no mês. Campos vazios não são completados com dados presumidos.');}catch(e){msg(e.message);}finally{busy=false;$('reload').disabled=false;}}\n$('generate').onclick=async()=>{if(!current||busy)return;busy=true;$('generate').disabled=true;$('record').disabled=true;$('month').disabled=true;document.querySelectorAll('#fields input,#fields textarea,#photos input').forEach(e=>e.disabled=true);msg('Gerando documento e PDF…');const p={id:current.id,hash:current.hash,fotos:[...$('photos').querySelectorAll('input:checked')].map(x=>x.dataset.url)};fields.forEach(([k])=>p[k]=$('f_'+k).value);try{const result=await rpc('gerarDocumentoRelatoSocial',p);dirty=false;$('result').replaceChildren(link('Abrir documento editável',result.doc),link('Abrir PDF para baixar ou imprimir',result.pdf));msg(result.mensagem);}catch(e){msg(e.message);}finally{busy=false;$('generate').disabled=false;$('record').disabled=false;$('month').disabled=false;document.querySelectorAll('#fields input,#fields textarea,#photos input').forEach(e=>e.disabled=false);}};\n$('record').onchange=choose;$('reload').onclick=load;$('month').onchange=load;\nconst now=new Date(),parts=new Intl.DateTimeFormat('en-CA',{timeZone:'America/Sao_Paulo',year:'numeric',month:'2-digit'}).formatToParts(now);$('month').value=parts.find(x=>x.type==='year').value+'-'+parts.find(x=>x.type==='month').value;load();\n</script></body></html>\n";
