  Object.keys(mapa).filter(k=>/^fotos? do diagnostico(?:$|\s*-)/.test(k)).forEach(k=>{
    (String(linha[mapa[k]]||'').match(/https:\/\/(?:drive|docs)\.google\.com\/[^\s,;]+/g)||[]).forEach(u=>{
      const m=u.match(/(?:[?&]id=|\/d\/)([\w-]+)/);if(m&&!ids[m[1]]){ids[m[1]]=true;urls.push(u.replace(/[)\]]+$/,''));}
    });
  });return urls;
}


/** Dashboard é um índice de navegação; os indicadores pertencem à Base Fichas Oficiais. */
function pgDashboardReferencia_(ss,avisos){
 const sh=ss.getSheetByName('Dashboard');if(!sh){avisos.push('Dashboard de Atendimento ausente. Os indicadores usam a Base Fichas Oficiais.');return null;}
 const values=sh.getDataRange().getValues(),aliases=['protocolo','numero de protocolo','numero do protocolo','protocolo do atendimento','id do atendimento','id'];
 const candidates=[];values.slice(0,100).forEach((r,i)=>{const h=r.map(pgCabecalho_),cols=h.map((x,j)=>aliases.includes(x)?j:-1).filter(j=>j>=0);if(cols.length===1&&h.some(x=>/^(status|status do atendimento|situacao|situacao do atendimento|nome|nome do solicitante|solicitante)$/.test(x)))candidates.push({i,col:cols[0]});});
 if(candidates.length!==1){avisos.push('O Dashboard de Atendimento mudou de estrutura. Os indicadores continuam pela Base Fichas Oficiais; os atalhos apontam para a base até a conferência do Dashboard.');return null;}
 const p=candidates[0],mapa={};mapa[pgNorm_('Protocolo')]=p.col;const seen=new Set();
 const linhas=values.slice(p.i+1).map((v,i)=>({v,linha:p.i+i+2})).filter(l=>/^ATD(?:\d{8}|-\d{4,8})$/i.test(pgTexto_(l.v[p.col])));
 for(const l of linhas){const id=pgTexto_(l.v[p.col]);if(seen.has(id)){avisos.push('Dashboard contém protocolo repetido. Atalhos individuais usam a Base Fichas Oficiais.');return null;}seen.add(id);}
 return {nome:'Dashboard',gid:sh.getSheetId(),mapa,linhas};
}
function pgCabecalho_(v){return pgNorm_(v).replace(/[^a-z0-9]+/g,' ').trim();}
function pgStatusEncerrado_(v){return ['concluida','concluido','encerrada','encerrado','finalizada','finalizado','atendimento concluido'].includes(pgCabecalho_(v));}
function pgRegistrarMidias_(allowed){
 const cache=CacheService.getUserCache(),pairs={};Object.keys(allowed).forEach(id=>{if(/^[\w-]{10,}$/.test(id))pairs['PG_MIDIA_'+id]=allowed[id];});
 const keys=Object.keys(pairs);for(let i=0;i<keys.length;i+=100){const chunk={};keys.slice(i,i+100).forEach(k=>chunk[k]=pairs[k]);cache.putAll(chunk,1800);}
}
function pgReferenciaPermitida_(id){if(!/^[\w-]{10,}$/.test(String(id)))throw new Error('Identificador de mídia inválido.');const u=CacheService.getUserCache().get('PG_MIDIA_'+id);if(!u)throw new Error('A consulta de mídias expirou. Use Atualizar visão.');return cptfReferencia_(u);}
function obterMidiaPainelExecutivo(id){
 try{
  const ref=pgReferenciaPermitida_(id),f=cptfArquivo_(ref),mime=f.getMimeType(),video=/^video\//.test(mime),image=/^image\//.test(mime);
  if(!video&&!image)return {erro:'O arquivo não é uma foto ou um vídeo.'};
  const key=f.getResourceKey?f.getResourceKey():ref.key,preview='https://drive.google.com/file/d/'+encodeURIComponent(f.getId())+'/preview'+(key?'?resourcekey='+encodeURIComponent(key):'');
  const out={tipoMidia:video?'Vídeo':'Foto',mime,preview:video?preview:'',url:ref.url,nome:f.getName()};
  try{const r=cptfLer_(ref.url,true);out.src='data:'+r.blob.getContentType()+';base64,'+Utilities.base64Encode(r.blob.getBytes());out.metodo=r.metodo;}
  catch(e){out.erroMiniatura=e.message;if(!video)out.erro=e.message;}
  return out;
 }catch(e){return {erro:e.message};}
}
function obterImagemPainelExecutivo(id){return obterMidiaPainelExecutivo(id);}
/** Somente as duas pessoas autorizadas. Não publica arquivos nem altera acessos de terceiros. */
const PG_GESTORES=Object.freeze(['cintia.nociti@veolia.com','emerson.miola@veolia.com']);
function pgCatalogoMidias_(){
 const t=pgTabela_(SpreadsheetApp.openById(PG.PROCEDIMENTOS),'Base Consolidada',[PG.CAMPOS.id,PG.CAMPOS.data,PG.CAMPOS.procedimento]);
 const cols=Object.keys(t.mapa).filter(k=>/foto|imagem|imagens|video|anexo|evidencia/.test(k)).map(k=>t.mapa[k]);const refs={};
 t.linhas.forEach(l=>pgFotos_(cols.map(c=>l.v[c]).concat(l.midiasRicas||'',l.fotosRicas||'').join(' ')).forEach(f=>refs[f.id]=f.url));
 // Inclui mídias dos relatos recentes que eventualmente ainda não constem na base.
 try{pgLerDiarioExecutivo_().forEach(d=>d.relatos.forEach(r=>r.fotos.forEach(f=>refs[f.id]=f.url)));}catch(e){console.warn('Catálogo do RDAS: '+e.message);}
 return Object.keys(refs).sort().map(id=>({id,url:refs[id]}));
}
function ativarAcessoMidiasGestao(){
 const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss||ss.getId()!==PG.DESTINO)throw new Error('Execute no projeto do Painel de Gestão.');
 const owner=Session.getEffectiveUser().getEmail();if(!owner)throw new Error('Não foi possível identificar a conta que autoriza o compartilhamento.');
 if(!ScriptApp.getProjectTriggers().some(t=>t.getHandlerFunction()==='pgAtualizarAutomaticamente'))throw new Error('Use a conta que já mantém o gatilho pgAtualizarAutomaticamente.');
 const p=PropertiesService.getScriptProperties(),old=JSON.parse(p.getProperty('PG_ACESSO_MIDIAS')||'null');
 if(old&&old.owner!==owner)throw new Error('A rotina de mídias pertence a outra conta. Use '+old.owner+'.');
 p.setProperty('PG_ACESSO_MIDIAS',JSON.stringify({owner,ativo:true}));p.deleteProperty('PG_ACESSO_CICLO');return pgSincronizarAcessosMidias_();
}
function pausarAcessoMidiasGestao(){const p=PropertiesService.getScriptProperties(),c=JSON.parse(p.getProperty('PG_ACESSO_MIDIAS')||'null');if(c){c.ativo=false;p.setProperty('PG_ACESSO_MIDIAS',JSON.stringify(c));}return 'Rotina pausada. Permissões já concedidas foram preservadas.';}
function pgConcederVisualizacao_(f,email){
 const acesso=String(f.getAccess(email));if(['VIEW','EDIT','COMMENT','OWNER','ORGANIZER','FILE_ORGANIZER'].includes(acesso))return 'existente';
 f.addViewer(email);
 return 'concedido';
}
function pgSincronizarAcessosMidias_(){
 const p=PropertiesService.getScriptProperties(),cfg=JSON.parse(p.getProperty('PG_ACESSO_MIDIAS')||'null');if(!cfg||!cfg.ativo||cfg.owner!==Session.getEffectiveUser().getEmail())return null;
 const lock=LockService.getScriptLock();if(!lock.tryLock(500))return {ocupado:true};
 try{
  let state=JSON.parse(p.getProperty('PG_ACESSO_CICLO')||'null');if(state&&state.concluido&&Date.now()-state.terminou<30*60000)return state;
  const refs=pgCatalogoMidias_(),hash=pgHash_(refs);if(!state||state.hash!==hash||state.concluido)state={hash,total:refs.length,indice:0,ok:0,ignorados:0,falhas:0,erros:[],concluido:false,inicio:new Date().toISOString()};
  const inicio=Date.now();let n=0;
  while(state.indice<refs.length&&n<20&&Date.now()-inicio<35000){const ref=refs[state.indice];try{const f=cptfArquivo_(cptfReferencia_(ref.url));if(!/^(image|video)\//.test(f.getMimeType()))state.ignorados++;else{for(const email of PG_GESTORES)pgConcederVisualizacao_(f,email);state.ok++;}}catch(e){state.falhas++;if(state.erros.length<8)state.erros.push({id:ref.id,motivo:String(e.message).slice(0,450)});console.warn('Acesso à mídia '+ref.id+': '+e.message);}state.indice++;n++;p.setProperty('PG_ACESSO_CICLO',JSON.stringify(state));}
  state.concluido=state.indice>=refs.length;if(state.concluido)state.terminou=Date.now();state.atualizado=new Date().toISOString();p.setProperty('PG_ACESSO_CICLO',JSON.stringify(state));return state;
 }finally{lock.releaseLock();}
}
function diagnosticarAcessosGestao(){const p=PropertiesService.getScriptProperties(),out={gestores:PG_GESTORES,config:JSON.parse(p.getProperty('PG_ACESSO_MIDIAS')||'null'),andamento:JSON.parse(p.getProperty('PG_ACESSO_CICLO')||'null')};console.log(JSON.stringify(out,null,2));return out;}
function conferirIntegracaoGestao(){const f=pgLerFontes_(),m=pgMontarModelo_(f,pgConfig_(),new Date());const r={versao:PG.VERSAO,somenteLeitura:true,casos:m.casos.length,abertos:m.abertos.length,referenciaDashboard:!!f.dashboard,avisos:m.avisos.map(x=>x.texto)};console.log(JSON.stringify(r,null,2));return r;}

