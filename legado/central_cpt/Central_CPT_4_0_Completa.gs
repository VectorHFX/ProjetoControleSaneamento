function c40ValidarModelo_(v,r){const max=r.categoria==='territorios'?12:2;if(!v||!Array.isArray(v.fotos)||v.fotos.length>max||new Set(v.fotos).size!==v.fotos.length||v.fotos.some(id=>!r.fotos.some(f=>f.id===id)))throw Error('Escolha até '+max+' fotos vinculadas a este registro.');const out={fotos:v.fotos,legendas:{}};(r.categoria==='territorios'?['titulo','texto','encaminhamentos','notasInternas','estadoAnalise']:['titulo','atividade','local','endereco','dataHorario','mediacao','publico','objetivo','texto','resultados']).forEach(k=>{out[k]=String(v[k]||'').trim();if(out[k].length>(['texto','objetivo','resultados','encaminhamentos','notasInternas'].includes(k)?20000:500))throw Error('Campo muito extenso: '+k);});v.fotos.forEach(id=>out.legendas[id]=String((v.legendas||{})[id]||'').slice(0,300));if(r.categoria==='territorios'){out.estadoAnalise=out.estadoAnalise||'Rascunho';if(!['Rascunho','Em revisão','Revisado'].includes(out.estadoAnalise))throw Error('Situação de revisão inválida.');out.oficiais={};c40CamposOficiais_().forEach(f=>out.oficiais[f[0]]=String((v.oficiais||{})[f[0]]||'').slice(0,2000));}if(JSON.stringify(out).length>40000)throw Error('Limite total de 40.000 caracteres na ficha.');return out;}
function c40Lease_(key,fn){const p=PropertiesService.getScriptProperties(),lock=LockService.getScriptLock(),k='C40_LEASE_'+key,token=Utilities.getUuid();if(!lock.tryLock(5000))throw Error('Outra gravação está terminando.');try{const old=JSON.parse(p.getProperty(k)||'null');if(old&&Date.now()-old.t<600000)throw Error('Este arquivo está sendo preparado. Use os links existentes enquanto isso.');p.setProperty(k,JSON.stringify({token,t:Date.now()}));}finally{lock.releaseLock();}try{return fn();}finally{const cur=JSON.parse(p.getProperty(k)||'null');if(cur&&cur.token===token)p.deleteProperty(k);}}
