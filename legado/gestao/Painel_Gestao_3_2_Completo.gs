function pg3SheetBlob_(id,format){const r=UrlFetchApp.fetch('https://docs.google.com/spreadsheets/d/'+id+'/export?format='+format+(format==='pdf'?'&size=A4&portrait=false&fitw=true&gridlines=false':''),{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error('Exportação indisponível. Tente novamente.');return r.getBlob();}
function pg3Binario_(id,blob,nome,pasta){blob.setName(nome);if(!id)return pasta.createFile(blob).getId();const r=UrlFetchApp.fetch('https://www.googleapis.com/upload/drive/v3/files/'+encodeURIComponent(id)+'?uploadType=media&supportsAllDrives=true',{method:'patch',contentType:blob.getContentType(),payload:blob.getBytes(),headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},muteHttpExceptions:true});if(r.getResponseCode()>=300)throw Error('Não foi possível atualizar o arquivo.');return id;}
function pg3Galeria(p){const mes=pg3Mes_(p.mes),offset=Math.max(0,Number(p.cursor)||0),avisos=[],itens=[];let next=null;try{const ss=SpreadsheetApp.openById(PG.RDAS),days=ss.getSheets().map(s=>{const m=s.getName().match(/^RDAS (\d{2})-(\d{2})-(\d{4})$/);return m?{s,dia:m[3]+'-'+m[2]+'-'+m[1]}:null;}).filter(x=>x&&x.dia.slice(0,7)===mes).sort((a,b)=>b.dia.localeCompare(a.dia));days.slice(offset,offset+2).forEach(x=>{const range=x.s.getDataRange(),values=range.getValues(),rich=range.getRichTextValues();const links=values.map((row,i)=>{const out=[];row.forEach((v,j)=>{(String(v).match(/https:\/\/(?:drive|docs)\.google\.com\/[^\s,;]+/g)||[]).forEach(u=>out.push(u));const rt=rich[i][j];if(rt){if(rt.getLinkUrl())out.push(rt.getLinkUrl());rt.getRuns().forEach(run=>{if(run.getLinkUrl())out.push(run.getLinkUrl());});}});return out;});const d=pgExtrairDiaRDAS_(values,links,x.s.getSheetId(),x.s.getName());if(d)(d.relatos||[]).forEach(r=>(r.fotos||[]).forEach(f=>itens.push({id:f.id,url:f.url,data:x.dia,titulo:r.atividade,bairro:r.bairro||'',legenda:f.rotulo||f.nome||'',origem:'RDAS'})));});next=offset+2<days.length?offset+2:null;}catch(e){avisos.push('RDAS: '+e.message);}if(offset===0)try{const c=pg3Central_('itens');c.itens.filter(x=>x.key.startsWith('midiaExtra:')&&String(x.valor.dataIso).slice(0,7)===mes).forEach(x=>{const v=x.valor;itens.push({id:v.fileId,url:v.url,data:v.dataIso,titulo:v.atividade||v.tema||'',bairro:v.bairro||'',legenda:v.rotulo||v.legenda||'',origem:'Fotos extras'});});}catch(e){avisos.push('Extras: '+e.message);}const seen=new Set(),out=itens.filter(x=>{const k=x.id+'|'+x.data+'|'+x.titulo;if(!x.id||seen.has(k))return false;seen.add(k);return true;});const allowed={};out.forEach(x=>allowed[x.id]=x.url);pgRegistrarMidias_(allowed);return {itens:out,proximo:next,avisos};}
function pg3SugestoesMensais_(tipo,mes,rs){const out={},campo=(r,k)=>pg31Campo_(r,k),month=rs.filter(r=>String(r.data).slice(0,7)===mes);if(tipo==='parceiros'){const surveys=month.filter(r=>['pesquisas','cautelares'].includes(r.categoria));[[17,PG.CAMPOS.saneamento],[19,PG.CAMPOS.melhoria]].forEach(([key,field])=>{const ns=surveys.map(r=>pgNota_(campo(r,field))).filter(n=>n!==null);if(ns.length)out[key]={valor:Math.round(ns.reduce((a,b)=>a+b,0)/ns.length*100)/100,origem:'Média de '+ns.length+' notas válidas. Não é NPS.'};});}else{const rel=month.filter(r=>r.categoria==='relatos'&&!pgNorm_(r.atividade).includes('logistica interna'));out[29]={valor:rel.length,origem:'Relatos do mês, excluindo logística interna. Confira a cobertura da base antes de confirmar zero.'};[[28,'Total de participantes'],[34,'Quantidade de panfletos entregues']].forEach(([key,field])=>{const ns=rel.map(r=>pgNumero_(campo(r,field)));if(ns.length&&ns.every(n=>n!==null&&n>=0))out[key]={valor:ns.reduce((a,b)=>a+b,0),origem:ns.length+' quantidades preenchidas nos relatos do mês.'};});}return out;}

