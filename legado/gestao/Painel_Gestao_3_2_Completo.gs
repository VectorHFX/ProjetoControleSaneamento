function pg3Entidades_(){const s=pg3Sheet_(false);return !s||s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,5).getValues().map((r,i)=>r[0]?({key:r[0],rev:+r[1],atualizado:String(r[2]),autor:r[3],valor:JSON.parse(r[4]),row:i+2}):null).filter(Boolean);}
function pg3Get_(key,items){return (items||pg3Entidades_()).find(x=>x.key===key)||{key,rev:0,valor:{}};}
function pg3PutUnlocked_(key,rev,value){const old=pg3Get_(key);if(old.rev!==rev)throw Error('Outra pessoa alterou este item. Seu formulário foi preservado; copie o texto e atualize a consulta.');const json=JSON.stringify(value);if(json.length>45000)throw Error('Divida este registro em itens menores.');const s=pg3Sheet_(true),row=old.row||s.getLastRow()+1;if(row>s.getMaxRows())s.insertRowsAfter(s.getMaxRows(),100);const now=new Date().toISOString();s.getRange(row,1,1,5).setValues([[key,rev+1,now,Session.getActiveUser().getEmail()||'Conta Google',json]]);SpreadsheetApp.flush();return {key,rev:rev+1,valor:value,atualizado:now};}
function pg3Put_(key,rev,value){const lock=LockService.getScriptLock();if(!lock.tryLock(5000))throw Error('Há uma gravação em andamento. Tente novamente.');try{return pg3PutUnlocked_(key,rev,value);}finally{lock.releaseLock();}}
