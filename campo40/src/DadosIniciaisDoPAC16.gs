  static corrigirTexto(texto) {
    return DadosIniciaisDoPAC16.correcoes.reduce((t,par) => t.split(par[0]).join(par[1]),String(texto || ''));
  }

  static corrigirFormulario(form) {
    form.getItems().forEach(x => {
      const titulo=x.getTitle(),ajuda=x.getHelpText() || '';const novo=DadosIniciaisDoPAC16.corrigirTexto(titulo),novaAjuda=DadosIniciaisDoPAC16.corrigirTexto(ajuda);
      if(novo!==titulo)x.setTitle(novo);if(novaAjuda!==ajuda)x.setHelpText(novaAjuda);
      const tipo=String(x.getType());if(!['LIST','MULTIPLE_CHOICE','CHECKBOX'].includes(tipo))return;
      const q=AuditoriaDoFormulario.tipar(x),opcoes=q.getChoices();
      if(!opcoes.some(c => DadosIniciaisDoPAC16.corrigirTexto(c.getValue())!==c.getValue()))return;
      q.setChoices(opcoes.map(c => {
        const valor=DadosIniciaisDoPAC16.corrigirTexto(c.getValue());
        if(tipo==='CHECKBOX')return q.createChoice(valor);
        const rota=c.getPageNavigationType();
        return String(rota)==='GO_TO_PAGE'?q.createChoice(valor,c.getGotoPage()):rota?q.createChoice(valor,rota):q.createChoice(valor);
      }));
    });
  }
