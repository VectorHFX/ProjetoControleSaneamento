function pg31MigrarEquipe_(){const props=PropertiesService.getScriptProperties();if(props.getProperty('PG31_EQUIPE'))return;const all=pg3Entidades_(),map=new Map(all.map(e=>[e.key,e]));const chefs={3:10,4:10,6:5,7:5,8:2,9:2};Object.keys(chefs).forEach(i=>{const e=map.get('pessoa:base-'+i);if(e){const v=Object.assign({},e.valor,{chefia:'base-'+chefs[i]});pg3PutUnlocked_(e.key,e.rev,v);}});props.setProperty('PG31_EQUIPE','1');}
var PG31_CAMPOS_MAP=new WeakMap();
function pg31Campo_(r,k){let map=PG31_CAMPOS_MAP.get(r);if(!map){map=new Map();(r.campos||[]).forEach(f=>{const key=pgNorm_(f.campo);if(!map.has(key))map.set(key,f.valor);});PG31_CAMPOS_MAP.set(r,map);}const value=map.get(pgNorm_(k));return value==null?'':value;}
