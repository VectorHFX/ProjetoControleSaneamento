/** Gestão 3.2 — destinos oficiais; Indicadores 2026 permanece somente leitura. */
function pg32Destino_(p){
 const mes=pg3Mes_(p.mes),tipo=p.tipo;if(!PG3_CAMPOS[tipo])throw Error('Ferramenta inválida.');
 const id=tipo==='parceiros'?PG3.parceiros:PG.ANEXOS,ss=SpreadsheetApp.openById(id);
 const s=tipo==='parceiros'?ss.getSheets().find(x=>x.getSheetId()===2014363223):ss.getSheetByName('Indicadores 2026');
 if(!s)throw Error('Aba oficial não localizada. Confira os acessos.');
 if(tipo==='anexos')return {id,ss,s,col:0,token:'somente-leitura'};
 pg3mValidarMascara_(s,tipo);const col=pg3mColParceiros_(s,mes,false);
 const header=s.getRange(2,1,1,s.getLastColumn()).getDisplayValues(),range=col?s.getRange(1,col,92,1):null;
 const vals=range?range.getValues():[],formulas=range?range.getFormulas():[];
 const content=JSON.stringify([id,s.getSheetId(),mes,col,header,vals,formulas]);
 const token=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,content));
 return {id,ss,s,col,vals,formulas,token};
}
function pg3Mensal(p){
 const d=pg32MensalBase_(p);d.destinoToken='';d.somenteLeitura=p.tipo==='anexos';
 try{const target=pg32Destino_(p);d.destinoToken=target.token;d.destinoUrl='https://docs.google.com/spreadsheets/d/'+target.id+'/edit#gid='+target.s.getSheetId();}catch(e){d.avisos.push('Destino oficial: '+e.message);}
 if(d.somenteLeitura)d.avisos.push('Indicadores 2026 está preservado: respostas são rascunhos da Gestão e não serão gravadas nessa aba. Os downloads refletem os anexos oficiais.');
 return d;
}
function pg32GravarConferidos_(s,col,campos,tipo){
 if(tipo!=='parceiros'||s.getName()==='Indicadores 2026')throw Error('Indicadores 2026 não pode ser alterado por esta atualização.');
 const allowed=new Set(PG3_CAMPOS[tipo].map(f=>String(f.linha)));
 const keys=Object.keys(campos).filter(k=>campos[k].confirmado).sort((a,b)=>+a-+b);
 if(!keys.length)throw Error('Salve ao menos um campo conferido.');
 if(keys.some(k=>!allowed.has(k)))throw Error('Campo fora da máscara autorizada.');
 const range=s.getRange(1,col,92,1),old=range.getValues(),formulas=range.getFormulas();
 const rows=keys.filter(k=>{
  const v=campos[k].valor;if(v===null||v===undefined||v==='')throw Error('Campo conferido vazio na linha '+k+'.');
  if(formulas[+k-1][0])throw Error('A linha '+k+' contém fórmula. Desmarque esse campo para preservar o cálculo da planilha.');
  return old[+k-1][0]!==v;
 }).map(Number);
