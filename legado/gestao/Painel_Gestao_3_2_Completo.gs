 // As posições úteis do modelo são mantidas; células extras devem estar vazias.
 const minimum={0:1,1:6,2:4,3:2,4:1,5:3,6:3};
 for(let r=0;r<23;r++){
   const count=t.getRow(r).getNumCells(),min=minimum[r]||2;
   if(count<min||count>6)throw new Error('Quantidade de células incompatível na linha '+(r+1)+': '+count+'.');
 }
 const begins=(r,c,text)=>pg31Norm_(t.getRow(r).getCell(c).getText()).startsWith(pg31Norm_(text));
 if(!begins(0,0,'DIAGNÓSTICO LOCAL')||!begins(4,0,'INFORMAÇÕES DO ENTORNO DAS OBRAS')||!begins(5,2,'OBSERVAÇÕES'))throw new Error('Cabeçalhos do modelo oficial não reconhecidos.');
 const mapped=new Set(['0:0','4:0','5:2','6:2']);
 pg31CamposOficiais_().forEach(f=>{
   const row=t.getRow(f[1]);
   if(row.getNumCells()<=f[2]+1||!begins(f[1],f[2],f[3]))throw new Error('Campo não reconhecido no modelo: '+f[3]+', linha '+(f[1]+1)+', coluna '+(f[2]+1)+'.');
   mapped.add(f[1]+':'+f[2]);mapped.add(f[1]+':'+(f[2]+1));
 });
 for(let r=0;r<23;r++){
   const row=t.getRow(r);
   for(let c=0;c<row.getNumCells();c++){
     if(!mapped.has(r+':'+c)&&row.getCell(c).getText().trim())
       throw new Error('Texto adicional fora dos campos mapeados: linha '+(r+1)+', coluna '+(c+1)+'. A ficha não foi preenchida. Confira o modelo em Configuração e revise o conteúdo extra indicado.');
   }
 }
 for(let i=0;i<body.getNumChildren();i++){const child=body.getChild(i);if(child.getType()!==DocumentApp.ElementType.TABLE && typeof child.getText==='function' && child.getText().trim())throw new Error('Há texto adicional fora da tabela do modelo. Confira para evitar transportar conteúdo do exemplo.');}
 return t;
}
