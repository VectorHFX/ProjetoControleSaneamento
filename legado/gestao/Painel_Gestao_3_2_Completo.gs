function pg3Salvar(p){if(!p||!['agenda','contato','pessoa'].includes(p.tipo))throw Error('Tipo de cadastro inválido.');let id=p.id||Utilities.getUuid();if(!/^[\w-]+$/.test(id))throw Error('Identificador inválido.');const v=p.valor||{},out={},text=(k,n)=>out[k]=pg3Texto_(v[k],n);out.arquivado=!!v.arquivado;
 if(p.tipo==='agenda'){['titulo','tema','responsavel','frente','estado','visibilidade','hora'].forEach(k=>text(k,200));text('notas',5000);out.data=pgDia_(v.data);if(!out.titulo||!out.data||out.data!==v.data)throw Error('Informe título e data válida.');if(out.hora&&!/^([01]\d|2[0-3]):[0-5]\d$/.test(out.hora))throw Error('Horário inválido.');if(!['Socioambiental','Comunicação','Compartilhada','Gestão'].includes(out.frente)||!['Pendente','Em andamento','Concluído','Cancelado'].includes(out.estado)||!['Interno','Compartilhável'].includes(out.visibilidade))throw Error('Confira frente, situação e visibilidade.');out.check=(v.check||[]).slice(0,30).map(x=>({texto:pg3Texto_(x.texto,200),feito:!!x.feito})).filter(x=>x.texto);if(out.estado==='Concluído'&&out.check.some(x=>!x.feito))throw Error('Conclua o checklist antes de concluir o compromisso.');}
 if(p.tipo==='contato'){['nome','instituicao','tipo','telefone','email','etiquetas','cor','referencia'].forEach(k=>text(k,300));text('notas',5000);if(!out.nome)throw Error('Informe o nome do contato.');if(!['Interno','Externo'].includes(out.tipo))throw Error('Selecione interno ou externo.');if(!['verde','terracota','azul','dourado'].includes(out.cor))throw Error('Cor inválida.');if(out.email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(out.email))throw Error('E-mail inválido.');}
