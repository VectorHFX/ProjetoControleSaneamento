function obterDadosPainelExecutivo(p){
  const cfg=pgConfig_();if(p&&p.mes!==undefined)cfg.mes=pgTexto_(p.mes);
  const m=pgMontarModelo_(pgLerFontes_(),cfg,new Date());let dias=[];
