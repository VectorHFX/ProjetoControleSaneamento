 const nums=rel.map(r=>pgNumero_(campo(r,'Total de participantes'))),notas=rs.map(r=>pgNota_(campo(r,PG.CAMPOS.saneamento))).filter(x=>x!==null),bairros={},tipos={},equipe={};rel.forEach(r=>{bairros[r.bairro||'Não informado']=(bairros[r.bairro||'Não informado']||0)+1;tipos[r.atividade||'Não informada']=(tipos[r.atividade||'Não informada']||0)+1;const n=r.responsavel||'Não informado';equipe[n]=(equipe[n]||0)+1;});const count=o=>Object.keys(o).map(nome=>({nome,valor:o[nome]})).sort((a,b)=>b.valor-a.valor);
