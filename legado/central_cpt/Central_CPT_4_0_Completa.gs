 completar.')+'</small>'+(sug?'<div class=\"suggestion\"><b id=\"sugvalue_'+f.linha+'\">Sugestão: '+esc(sug.valor??'dados incompletos')+'</b><small id=\"hint_'+f.linha+'\">'+esc(sug.origem)+'</small><button class=\"mini\" data-suggestion=\"'+f.linha+'\">Usar sugestão</button></div>':'')+'</div><div class=\"answerbox\"><label for=\"mf_'+f.linha+'\">RESPOSTA DESTE MÊS</label>'+(f.texto?'<textarea id=\"mf_'+f.linha+'\" rows=\"4\">'+esc(value)+'</textarea>':'<input id=\"mf_'+f.linha+'\" inputmode=\"decimal\" value=\"'+esc(value)+'\" placeholder=\"Valor ou Não se aplica\">')+'<small>'+esc(origin)+'</small><label class=\"check\"><input type=\"checkbox\" id=\"mc_'+f.linha+'\" '+(old&&old.confirmado?'checked':'')+'>Conferido para exportar</label><button class=\"mini\" data-next=\"'+f.linha+'\">Conferir e próxima →</button></div></div></section>'}).join('')+'</div><div class=\"section actions\"><button id=\"savemonth\" class=\"primary\">Salvar preenchimento</button><button id=\"exportmonth\">Gerar entrega mensal</button></div><p class=\"footnote\" id=\"monthstate\">Revisão '+d.rev+' · uma planilha, um Excel e um PDF por competência. Anotações internas de contatos e histórico não entram nesta entrega.</p></div>';$('view').innerHTML=h;$('monthlyfields').querySelectorAll('input,textarea').forEach(e=>e.oninput=()=>{S.dirty=true;monthlyProgress()});document.querySelectorAll('[data-meeting]').forEach(e=>e.onchange=()=>{S.dirty=true;msg('Use Recalcular sugestões para atualizar reuniões, público e temas.')});$('savemonth').onclick=e=>work(e.target,saveMonth);$('savemonthtop').onclick=e=>work(e.target,saveMonth);$('exportmonth').onclick=e=>work(e.target,exportMonth);$('importmask').onclick=e=>work(e.target,importMask);$('recalc').onclick=e=>work(e.target,recalc);if($('prompt'))$('prompt').onclick=makePrompt;['fieldsearch','fieldgroup','onlypending'].forEach(k=>$(k).oninput=filterFields);$('nextfield').onclick=()=>nextMonthly();document.querySelectorAll('[data-next]').forEach(b=>b.onc