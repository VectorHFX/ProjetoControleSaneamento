 const groups=[];rows.forEach(r=>{const g=groups[groups.length-1];if(g&&g[g.length-1]+1===r)g.push(r);else groups.push([r]);});
 const attempted=[];
 try{groups.forEach(g=>{attempted.push(g);s.getRange(g[0],col,g.length,1).setValues(g.map(r=>[pgLiteral_(campos[r].valor)]));});SpreadsheetApp.flush();}
 catch(e){let restored=true;attempted.reverse().forEach(g=>{try{s.getRange(g[0],col,g.length,1).setValues(g.map(r=>[pgLiteral_(old[r-1][0])]));}catch(restoreError){restored=false;}});try{SpreadsheetApp.flush();}catch(flushError){restored=false;}
  throw Error(restored?'A gravação falhou; os valores anteriores foram restaurados. '+e.message:'A gravação falhou e a restauração não foi completa. Confira as linhas '+rows.join(', ')+' antes de continuar. '+e.message);}
