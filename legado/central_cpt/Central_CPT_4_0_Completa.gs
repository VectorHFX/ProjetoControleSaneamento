function c40ExportarRelato(p){const r=c40Registro_(p.id);if(r.categoria!=='relatos'||!r.social)throw Error('Esta atividade não pertence às cinco categorias de relato ilustrado.');if(!r.data)throw Error('Corrija a data de origem antes de exportar.');return c40Lease_('relato:'+r.id,()=>{const e=c40Get_('ficha:'+r.id);if(!e.rev)throw Error('Salve a edição primeiro.');if(e.valor.hash!==r.hash)throw Error('A fonte mudou. Reabra e revise antes de gerar.');const folder=c40PastaMes_(r.data.slice(0,7));let item=c40Get_('arquivos:'+r.id),v=item.valor;for(const slot of ['original','final']){if(slot==='original'&&v.original&&v.original.pronto)continue;const m=slot==='original'?c40Modelo_(r):c40ValidarModelo_(e.valor,r);if(slot==='original'){m.fotos=e.valor.fotos.slice();m.legendas=Object.assign({},e.valor.legendas);}const photos=m.fotos.map(id=>({id,blob:c40FotoBlob_(r,id)}));if(!v[slot]){const d=DocumentApp.create(c40Nome_(r,slot.toUpperCase())),file=DriveApp.getFileById(d.getId());file.moveTo(folder);d.saveAndClose();v[slot]={doc:file.getId(),pronto:false};item=c40Put_(item.chave,item.rev,v,Utilities.getUuid());}v[slot].pronto=false;item=c40Put_(item.chave,item.rev,v,Utilities.getUuid());const doc=DocumentApp.openById(v[slot].doc);c40RenderRelato_(doc,m,r,photos);doc.saveAndClose();v[slot].pdf=c40Binario_(v[slot].pdf,DriveApp.getFileById(v[slot].doc).getAs(MimeType.PDF),c40Nome_(r,slot.toUpperCase())+'.pdf',folder);v[slot].pronto=true;v[slot].quando=new Date().toISOString();v[slot].revisao=slot==='final'?e.rev:0;if(slot==='final')v[slot].conteudo=m;item=c40Put_(item.chave,item.rev,v,Utilities.getUuid());}c40PublicarUltimo_();return v;});}
function c40Par_(body,text,bold,size){const p=body.appendParagraph('');if(bold)p.setHeading(DocumentApp.ParagraphHeading.HEADING2);String(text||'').split(/(\*\*[^*]+\*\*)/g).forEach(t=>p.appendText(t.startsWith('**')?t.slice(2,-2):t).setBold(!!bold||t.startsWith('**')));p.editAsText().setFontFamily('Arial').setFontSize(size||11).setForegroundColor('#173747');p.setSpacingAfter(8).setLineSpacing(1.15);return p;}
function c40RenderRelato_(doc,m,r,photos){const b=doc.getBody();b.clear();b.setPageWidth(595.28).setPageHeight(841.89).setMarginTop(34).setMarginBottom(36).setMarginLeft(42).setMarginRight(42);const h=b.appendTable([['Relato da atividade']]);h.setBorderWidth(0);h.getRow(0).getCell(0).setWidth(511).editAsText().setFontFamily('Arial').setFontSize(23).setBold(true).setForegroundColor('#083952');c40Par_(b,m.titulo,false,12).editAsText().setForegroundColor('#536D7A');const rows=[['Atividade',m.atividade],['Local',m.local],['Endereço e bairro',m.endereco],['Data e horário',m.dataHorario],['Mediação',m.mediacao],['Público',m.publico]],t=b.appendTable(rows.map(a=>[a[0],a[1]||'Não informado']));t.setBorderColor('#CFDDE5').setBorderWidth(.5);rows.forEach((_,i)=>{for(let j=0;j<2;j++){const cell=t.getRow(i).getCell(j);cell.setWidth(j?391:120).setPaddingTop(6).setPaddingBottom(6).setPaddingLeft(8).setPaddingRight(8);cell.editAsText().setFontFamily('Arial').setFontSize(10).setForegroundColor('#173747').setBold(!j);if(!j)cell.setBackgroundColor('#EAF4F8');}});[['Objetivo',m.objetivo],['Relato da atividade',m.texto],['Resultados e encaminhamentos',m.resultados]].forEach(a=>{if(a[1]){c40Par_(b,a[0],true,13).setSpacingBefore(12);a[1].split(/\n+/).forEach(p=>c40Par_(b,p,false,11));}});if(photos.length){c40Par_(b,'Registro fotográfico',true,13).setSpacingBefore(12);const pt=b.appendTable([photos.map(()=>'')]);pt.setBorderWidth(0);photos.forEach((f,i)=>{const cell=pt.getRow(0).getCell(i);cell.setWidth(511/photos.length);const p=cell.getChild(0).asParagraph(),img=p.appendInlineImage(f.blob),a=Math.min(495/photos.length/img.getWidth(),220/img.getHeight());img.setWidth(Math.round(img.getWidth()*a)).setHeight(Math.round(img.getHeight()*a));p.setAlignment(DocumentApp.HorizontalAlignment.CENTER);c40Par_(cell,m.legendas[f.id]||'Registro '+(i+1),false,9).setAlignment(DocumentApp.HorizontalAlignment.CENTER);});}const foot=doc.getFooter()||doc.addFooter();foot.clear();foot.appendParagraph(r.data+' · Consórcio Performance Tamanduateí').editAsText().setFontFamily('Arial').setFontSize(8).setForegroundColor('#536D7A');}
function c40ExportarDiagnostico(p){const r=c40Registro_(p.id);if(r.categoria!=='territorios'||!['ficha','slides'].includes(p.tipo))throw Error('Selecione um diagnóstico e a entrega.');return c40Lease_('diagnostico:'+r.id,()=>{const e=c40Get_('ficha:'+r.id);if(!e.rev||e.valor.hash!==r.hash)throw Error('Reabra e salve a revisão atual antes de gerar.');const m=c40ValidarModelo_(e.valor,r);const folder=c40PastaMes_(r.data?r.data.slice(0,7):c40Cfg_().mes),key='arquivos:'+r.id;let item=c40Get_(key),v=item.valor;if(p.tipo==='ficha'){c40TabelaOficial_(DocumentApp.openById(c40Cfg_().modeloDiagnostico));if(!v.diagnostico){v.diagnostico={doc:DriveApp.getFileById(c40Cfg_().modeloDiagnostico).makeCopy(c40Nome_(r,'FICHA SABESP'),folder).getId()};item=c40Put_(key,item.rev,v,Utilities.getUuid());}const doc=DocumentApp.openById(v.diagnostico.doc),t=c40TabelaOficial_(doc);c40CamposOficiais_().forEach(f=>t.getRow(f[1]).getCell(f[2]+1).editAsText().setText(m.oficiais[f[0]]||'Não informado'));t.getRow(6).getCell(2).editAsText().setText([m.texto,m.encaminhamentos?'Próximos passos\n'+m.encaminhamentos:''].filter(Boolean).join('\n\n')||'Não informado');doc.saveAndClose();v.diagnostico.pdf=c40Binario_(v.diagnostico.pdf,DriveApp.getFileById(v.diagnostico.doc).getAs(MimeType.PDF),c40Nome_(r,'FICHA SABESP')+'.pdf',folder);v.diagnostico.quando=new Date().toISOString();}else{const photos=m.fotos.map(id=>c40FotoBlob_(r,id));if(!v.slides){const deck=SlidesApp.create(c40Nome_(r,'APRESENTAÇÃO'));DriveApp.getFileById(deck.getId()).moveTo(folder);v.slides={doc:deck.getId()};deck.saveAndClose();item=c40Put_(key,item.rev,v,Utilities.getUuid());}const deck=SlidesApp.openById(v.slides.doc);c40RenderSlides_(deck,m,r,photos);deck.saveAndClose();v.slides.pdf=c40Binario_(v.slides.pdf,DriveApp.getFileById(v.slides.doc).getAs(MimeType.PDF),c40Nome_(r,'APRESENTAÇÃO')+'.pdf',folder);v.slides.quando=new Date().toISOString();}c40Put_(key,item.rev,v,Utilities.getUuid());return v;});}
