ese curta, objetiva e fiel para o Programa Parceiros, competência '+d.mes+'. Use somente as evidências abaixo. Separe satisfação com serviços e percepção de qualidade de vida quando houver evidência específica. Preserve críticas e opiniões divergentes. Não invente quantidades, causas, soluções, promessas ou melhora. Ausência de resposta não é aprovação. Não generalize a amostra para toda a população. Se faltarem dados, diga que são insuficientes. Não inclua nomes ou contatos. Responda em até dois parágrafos.\\n\\n'+d.depoimentos.map(x=>x.codigo+' | Nota dos serviços: '+(x.nota??'não informada')+'\\n'+x.textos.map(clean).join('\\n')).join('\\n\\n');$('promptbox').classList.remove('hide');$('copyprompt').onclick=async()=>{try{await navigator.clipboard.writeText($('prompttext').value);msg('Prompt copiado.')}catch(e){$('prompttext').select();msg('Texto selecionado. Pressione Ctrl+C.')}};}\nasync function agendaBase(token){$('view').innerHTML='<div class=\"empty\">Organizando o mês…</div>';const a=await rpc('c40Agenda',{mes:mes()});if(token!==S.token)return;S.agenda=a;const pending=a.tarefas.filter(t=>!['Concluído','Cancelado'].includes(t.estado)),late=pending.filter(t=>t.data<a.hoje);let h=heading('Um mês com direção','Temas, ações e entregas numa agenda compartilhada.','<button id=\"newtask\" class=\"primary\">+ Novo compromisso</button>')+'<div class=\"notice '+(late.length?'warn':'')+'\">'+pending.length+' compromisso(s) pendente(s) · '+late.length+' com prazo vencido. Lembretes aparecem aqui e no Início; não há e-mails automáticos nesta versão.</div><div class=\"calendar\">'+['SEG','TER','QUA','QUI','SEX','SÁB','DOM'].map(d=>'<div class=\"dayhead\">'+d+'</div>').join('');const first=new Date(mes()+'-01T12:00:00Z'),offset=(first.getUTCDay()+6)%7,days=new Date(+mes().slice(0,4),+mes().slice(5),0).getDate();for(let i=0;i<Math.ceil((offset+days)/7)*7;i++){const n=i-offset+1,date=mes()+'-'+String(n).padStart(2,'0');h+=n<1||n>days?'<div class=\"day blank\"></div>':'<div c